// File name: projects/01/DMux8Way.hdl

/**
 * 8-way demultiplexor:
 * {a, b, c, d, e, f, g, h} = {in, 0, 0, 0, 0, 0, 0, 0} if sel == 000
 *                            {0, in, 0, 0, 0, 0, 0, 0} if sel == 001
 *                            etc.
 *                            {0, 0, 0, 0, 0, 0, 0, in} if sel == 111
 */

CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
       Not(in=sel[2], out=n2);
    Not(in=sel[1], out=n1);
    Not(in=sel[0], out=n0);

    And(a=in, b=n2, out=t00);
    And(a=t00, b=n1, out=t01);
    And(a=t01, b=n0, out=a);

    And(a=in, b=n2, out=t10);
    And(a=t10, b=n1, out=t11);
    And(a=t11, b=sel[0], out=b);

    And(a=in, b=n2, out=t20);
    And(a=t20, b=sel[1], out=t21);
    And(a=t21, b=n0, out=c);

    And(a=in, b=n2, out=t30);
    And(a=t30, b=sel[1], out=t31);
    And(a=t31, b=sel[0], out=d);

    And(a=in, b=sel[2], out=t40);
    And(a=t40, b=n1, out=t41);
    And(a=t41, b=n0, out=e);

    And(a=in, b=sel[2], out=t50);
    And(a=t50, b=n1, out=t51);
    And(a=t51, b=sel[0], out=f);

    And(a=in, b=sel[2], out=t60);
    And(a=t60, b=sel[1], out=t61);
    And(a=t61, b=n0, out=g);

    And(a=in, b=sel[2], out=t70);
    And(a=t70, b=sel[1], out=t71);
    And(a=t71, b=sel[0], out=h);
}